      "launchBrowser": true,
      "applicationUrl": "https://cleanarchieturenofrontend.dev.localhost:17070;http://cleanarchieturenofrontend.dev.localhost:15251",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
